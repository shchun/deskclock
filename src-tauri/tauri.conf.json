{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk Clock",
  "version": "../package.json",
  "identifier": "com.deskclock.widget",
  "build": {
    "beforeDevCommand": "node scripts/prepare-desktop.cjs",
    "beforeBuildCommand": "node scripts/prepare-desktop.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
